/// The plugin contract, as the Component Model's interface definition language.
///
/// # What this file is
///
/// The one place the host's surface and a plugin's obligations are written down. Everything else that knows about
/// them is *derived*: `tools/wit-codegen` reads this file and produces the capability table `synra-plugin-host`
/// enforces, and `synra-plugin-cli`'s import checks compare a built artifact against the same table. A function added
/// here without a capability is a compile-and-test failure rather than an ungated host call nobody noticed.
///
/// # The annotations are not WIT
///
/// `@ungated` and `@capability("…")` are comments as far as a WIT toolchain is concerned — they begin with `@` inside
/// a doc comment, which the syntax ignores. They are read by `wit-codegen`, and they exist because the capability a
/// function needs is a fact about the *host*, not about the interface: WIT has no way to say "this call requires
/// `storage:local:write`", and putting it in a name would be a convention nothing checks.
///
/// A function with neither annotation is a **refusal**: the generator reports it rather than assuming a gate, because
/// the one outcome that must not be possible is a host function that is reachable without a capability.
///
/// # Everything cross-boundary is a string
///
/// The complex payloads are JSON in a `string`, deliberately. A WIT type that gained a field would be a breaking
/// change for every plugin built against the old one, and the kernel parses these anyway — the capability gate and
/// the audit record both need the structure. The types that *are* WIT types are the ones whose shape will not change:
/// a log level, a device's identity, the outcome of a call.
package synra:plugin@1.0.0;

interface types {
    /// How loud a log line is, matching the host's own levels.
    enum log-level {
        trace,
        debug,
        info,
        warn,
        error,
    }

    /// What kind of machine a device is.
    ///
    /// Three kinds rather than a platform string: a plugin deciding whether to offer a file transfer cares whether the
    /// other end can show a dialog, not whether it runs Windows.
    enum device-kind {
        desktop,
        mobile,
        headless,
    }

    /// A device this kernel can see.
    record device-target {
        id: string,
        name: string,
        kind: device-kind,
    }

    /// A message crossing the boundary.
    ///
    /// `payload` is JSON. The envelope is a WIT record because its three fields are what every message has; the
    /// payload is not, because a payload's shape is the plugin's business.
    record envelope {
        event: string,
        target: string,
        payload: string,
    }

    /// Why a call failed.
    ///
    /// `code` is one of the kernel's stable error codes, so a plugin can branch on it without parsing a sentence.
    record error {
        code: string,
        message: string,
        details: option<string>,
    }

    /// What a call produced.
    ///
    /// A value rather than a trap: Wasm has no exceptions, and a trap is for an unrecoverable bug. A plugin that
    /// cannot reach a device has *failed*, which is a thing it can handle.
    variant outcome {
        ok(string),
        err(error),
    }
}

/// What the host offers a plugin.
///
/// Every function except the five `env-*` queries is gated: the gate is checked before the call runs, and the
/// capability it needs is the annotation above it.
interface host {
    use types.{log-level, device-target, envelope, outcome};

    // ── Ungated: read-only facts about the environment ───────────────────────────────────────────────
    //
    // These five are the exception the design document names. Each answers a question a plugin needs the answer to
    // *before* it can decide what to ask for — what version of the host this is, whether a dark theme is set — so
    // gating them would mean a plugin had to request a capability to discover whether it wants it.

    /// The host SDK's version.
    /// @ungated
    env-sdk-version: func() -> string;

    /// What kind of host this is: `desktop`, `mobile` or `headless`.
    /// @ungated
    env-host-kind: func() -> string;

    /// The user's locale, as a BCP 47 tag.
    /// @ungated
    env-locale: func() -> string;

    /// Whether the interface is in a dark theme.
    /// @ungated
    env-dark-mode: func() -> bool;

    /// Whether the plugin may use a capability, without using it.
    ///
    /// Ungated on purpose: a plugin that has to *call* something to find out whether it may is one that has already
    /// done the thing. This is how a plugin hides a button it cannot use.
    /// @ungated
    env-can: func(capability: string) -> bool;

    // ── log:* ───────────────────────────────────────────────────────────────────────────────────────

    /// Write a line to the kernel's log.
    /// @capability("log:*")
    log: func(level: log-level, message: string, ctx: option<string>);

    // ── event:emit:* / event:subscribe:* ────────────────────────────────────────────────────────────

    /// Publish an event to whoever subscribed.
    /// Plugin events use `_plugin.<full @scope/name>.<topic>` and are bounded to 240 ASCII bytes.
    /// Complete package ownership and the concrete event grant are checked independently.
    /// @capability("event:emit:*")
    event-emit: func(event: string, payload: string) -> outcome;

    /// Subscribe to events matching a pattern.
    ///
    /// Delivery is a guest export: the host holds the callback table. There is no host-observable object a plugin
    /// could share, because a Wasm sandbox has no such thing.
    /// @capability("event:subscribe:*")
    event-subscribe: func(pattern: string) -> outcome;

    // ── device:list / device:send[:target] / device:broadcast ───────────────────────────────────────

    /// Every device this kernel can see.
    /// @capability("device:list")
    device-list: func() -> list<device-target>;

    /// Send an event to one device.
    /// @capability("device:send:*")
    device-send: func(target: string, event: string, payload: string) -> outcome;

    /// Send an event to every paired device.
    /// @capability("device:broadcast")
    device-broadcast: func(event: string, payload: string) -> outcome;

    // ── storage:local:* ─────────────────────────────────────────────────────────────────────────────
    //
    // A plugin's own storage, keyed by its id. There is no path and no namespace argument: giving one would be
    // giving every plugin the ability to guess another's.

    /// Read a value, or `err` when the key is absent.
    /// @capability("storage:local:read")
    storage-get: func(key: string) -> outcome;

    /// Write a value.
    /// @capability("storage:local:write")
    storage-set: func(key: string, value: string) -> outcome;

    /// Remove a value.
    /// @capability("storage:local:write")
    storage-delete: func(key: string) -> outcome;

    /// Every key under a prefix, or every key when there is none.
    /// @capability("storage:local:read")
    storage-keys: func(prefix: option<string>) -> list<string>;

    /// How much storage the plugin is using, and how much it may.
    ///
    /// Ungated within the storage group would be wrong — this is a fact about the plugin's own quota, and the quota is
    /// part of what `storage:local:read` grants.
    /// @capability("storage:local:read")
    storage-quota: func() -> tuple<u64, u64>;

    // ── storage:secure:* ────────────────────────────────────────────────────────────────────────────
    //
    // Separate from `storage:local:*` because the OS keychain is a different promise: a user granting local storage
    // has not agreed to let the plugin write to their credential store.

    /// Read a secret from the OS keychain.
    /// @capability("storage:secure:read")
    secret-get: func(key: string) -> outcome;

    /// Write a secret to the OS keychain.
    /// @capability("storage:secure:write")
    secret-set: func(key: string, value: string) -> outcome;

    /// Remove a secret.
    /// @capability("storage:secure:write")
    secret-delete: func(key: string) -> outcome;

    // ── network:fetch:<host>[:<method>] ─────────────────────────────────────────────────────────────
    //
    // The host proxies every request. A plugin never opens a socket: the gate decides which hosts and which methods,
    // and the host is what enforces a redirect policy and a response size.

    /// Perform an HTTP request, as a JSON request object.
    /// @capability("network:fetch:*")
    network-fetch: func(request-json: string) -> outcome;

    /// Open a WebSocket.
    /// @capability("network:websocket:*")
    network-websocket: func(url: string) -> outcome;

    // ── file:transfer:* ─────────────────────────────────────────────────────────────────────────────
    //
    // Sending a file *to a device*, which is not the filesystem: nothing here names a path, and the host is the one
    // that reads the file the user chose.

    /// Begin a transfer.
    /// @capability("file:transfer:send")
    transfer-send: func(kind: string, target: string, meta-json: string) -> outcome;

    /// How a transfer is going.
    /// @capability("file:transfer:read")
    transfer-status: func(transfer-id: string) -> outcome;

    // ── platform:* ──────────────────────────────────────────────────────────────────────────────────
    //
    // Each platform action its own capability rather than one `platform:*`: a plugin that notifies has no business
    // simulating keystrokes, and one capability for both would make the permission dialog ask for both.

    /// Open a URL in the user's browser.
    /// @capability("platform:open-url")
    platform-open-url: func(url: string) -> outcome;

    /// Open a file or directory with the system's handler.
    /// @capability("platform:open-path")
    platform-open-path: func(path: string) -> outcome;

    /// Show a file in the system's file manager.
    /// @capability("platform:reveal-path")
    platform-reveal-path: func(path: string) -> outcome;

    /// Synthesize a keystroke.
    ///
    /// Off by default and never granted implicitly: a plugin that can type into whatever window is focused can do
    /// anything the user can.
    /// @capability("platform:simulate-keys")
    platform-simulate-keys: func(chord: string) -> outcome;

    /// Show a notification.
    /// @capability("platform:notify")
    platform-notify: func(title: string, body: string) -> outcome;

    /// Read the clipboard.
    /// @capability("platform:read-clipboard")
    platform-read-clipboard: func() -> outcome;

    /// Write the clipboard.
    /// @capability("platform:write-clipboard")
    platform-write-clipboard: func(text: string) -> outcome;

    /// Which platform actions this host can perform at all.
    ///
    /// Ungated: a plugin deciding whether to offer a menu item needs to know whether the host can do the thing, and
    /// asking is not doing.
    /// @ungated
    platform-capabilities: func() -> list<string>;

    // ── action:*（cross-plugin actions）─────────────────────────────────────────────────────────────

    /// Declare an action other plugins may call.
    /// @capability("action:declare")
    action-declare: func(name: string, schema-json: string) -> outcome;

    /// Call another plugin's action.
    /// @capability("action:invoke:*")
    action-invoke: func(target-plugin: string, name: string, args-json: string) -> outcome;

    /// Every action this kernel knows about, as a JSON array.
    /// @capability("action:list")
    action-list: func() -> string;

    // ── The plugin's own identity ───────────────────────────────────────────────────────────────────
    //
    // One function, ungated, and deliberately the only thing about the plugin itself the host answers. Its *data* is
    // reached through `storage:*`, which is a domain the capability system has and whose grants a user already
    // understands — a `plugin:data:clear` capability would be a second way to reach the same storage, gated by a name
    // that had to be invented for it.

    /// The plugin's own id.
    ///
    /// Ungated because it is the identity the kernel already used to load the component: a plugin asking who it is has
    /// told the host nothing it did not know, and a gate would mean a plugin had to request a capability to label its
    /// own log lines.
    /// @ungated
    plugin-id: func() -> string;
}

/// What a plugin must implement.
///
/// These are **exports**: the host calls them. Every plugin implements this interface whatever else it does, which is
/// why the manifest's `implementation` block is about the *optional* entry points rather than about these.
interface lifecycle {
    use types.{outcome};

    /// The plugin is being activated, first time or after being re-enabled.
    ///
    /// `config-json` is the plugin's own settings, so an activation does not need a second call to read them.
    activate: func(config-json: string) -> outcome;

    /// The plugin is being deactivated and must release everything it holds.
    ///
    /// No return value: a deactivation that failed is still a deactivation, and a host that could not stop a plugin
    /// would have to kill it — which is what this gives it the chance to avoid.
    deactivate: func();

    /// The host is asking the plugin to bring its own data forward.
    migrate: func(from-version: string, to-version: string) -> outcome;

    /// A timer the plugin asked for has fired.
    on-tick: func(tick-json: string) -> outcome;
}

/// Handling a share, which is how a plugin says "this is mine".
interface share {
    use types.{outcome};

    /// Whether this plugin can handle an item — **without side effects**.
    ///
    /// Returns JSON rather than an `outcome`, because declining is not a failure: `{"handled":false}` is a plugin
    /// saying "not mine", and a host that treated it as an error would log one for every plugin that was asked.
    ///
    /// This runs before the user has chosen anything, so a plugin that wrote a file here would have written it for
    /// every share the user cancelled.
    can-handle: func(item-json: string) -> string;

    /// Perform the action `can-handle` proposed.
    execute: func(action: string, args-json: string) -> outcome;
}

/// Declaring and invoking actions, which is how plugins compose.
interface actions {
    use types.{outcome};

    /// The action's own implementation, called after `action-declare` registered it.
    invoke: func(name: string, args-json: string) -> outcome;
}

/// The world a plugin component implements.
///
/// One world, versioned by the package: a plugin imports the host and exports the interfaces the kernel calls.
/// There is no second world for a UI-only plugin, because a UI plugin is a bundle the host serves rather than a
/// component it loads — the Manifest's `runtime` block is what says which halves exist.
world plugin {
    import host;

    export lifecycle;
    export share;
    export actions;
}
